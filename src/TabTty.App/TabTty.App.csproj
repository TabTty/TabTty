<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TabTty</AssemblyName>
    <Product>TabTty</Product>
    <RootNamespace>TabTty.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/TabTty.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="$(ApplicationIcon);Assets/tttykey.ico" />
    <None Update="Assets/tttym.ico;Assets/tttykey.ico;Assets/tttylog.ico"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../TabTty.Core/TabTty.Core.csproj" />
    <Compile Include="../TabTty.McpBridge/AiPipe.cs" Link="AiPipe.cs" />
    <Compile Include="../TabTty.McpBridge/AiFrames.cs" Link="AiFrames.cs" />
    <Compile Include="../TabTty.McpBridge/AiPrivateChannel.cs" Link="AiPrivateChannel.cs" />
    <Compile Include="../TabTty.McpBridge/AiPayloadBudget.cs" Link="AiPayloadBudget.cs" />
    <Compile Include="../TabTty.McpBridge/AiRateLimit.cs" Link="AiRateLimit.cs" />
    <Compile Include="../TabTty.McpBridge/McpArguments.cs" Link="McpArguments.cs" />
  </ItemGroup>
</Project>
