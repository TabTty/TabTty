<Window x:Class="TabTty.App.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TabTty.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TabTty" Width="1000" Height="700" MinHeight="320"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackground}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="5"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style x:Key="WindowGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="GroupSplitButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style x:Key="GroupSplitIcon" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.25" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ApplicationMenuSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ContextMenuBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ContextMenuBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0,3" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <ControlTemplate x:Key="TabGroupTemplate" TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="43" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border x:Name="tabStripRow" Margin="{TemplateBinding Padding}" Background="Transparent">
                            <Border.ContextMenu>
                                <ContextMenu Opened="OnTabStripMenuOpened">
                                    <MenuItem Click="CloseDisconnectedTabs" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,5,6,0"
                                            VerticalAlignment="Top">
                                    <Button x:Name="splitGroupsStackButton" Style="{StaticResource GroupSplitButton}"
                                            ToolTip="{DynamicResource SplitGroupsStackLabel}"
                                            AutomationProperties.Name="{DynamicResource SplitGroupsStackLabel}"
                                            Tag="{x:Static Orientation.Vertical}" Click="OnSplitGroup">
                                        <Path Style="{StaticResource GroupSplitIcon}" Data="M 1.5,2.5 H 14.5 V 13.5 H 1.5 Z M 1.5,8 H 14.5" />
                                    </Button>
                                    <Button x:Name="splitGroupsSideButton" Style="{StaticResource GroupSplitButton}"
                                            ToolTip="{DynamicResource SplitGroupsSideLabel}"
                                            AutomationProperties.Name="{DynamicResource SplitGroupsSideLabel}"
                                            Tag="{x:Static Orientation.Horizontal}" Click="OnSplitGroup">
                                        <Path Style="{StaticResource GroupSplitIcon}" Data="M 1.5,2.5 H 14.5 V 13.5 H 1.5 Z M 8,2.5 V 13.5" />
                                    </Button>
                                    <Button x:Name="removeTabGroupButton" Style="{StaticResource GroupSplitButton}"
                                            ToolTip="{DynamicResource RemoveTabGroupLabel}"
                                            AutomationProperties.Name="{DynamicResource RemoveTabGroupLabel}"
                                            Click="OnRemoveGroup">
                                        <Path Style="{StaticResource GroupSplitIcon}" Data="M 1.5,2.5 H 14.5 V 13.5 H 1.5 Z" />
                                    </Button>
                                </StackPanel>
                                <DockPanel Margin="6,5,14,0" HorizontalAlignment="Left" LastChildFill="False">
                                    <Button x:Name="tabListButton" DockPanel.Dock="Left"
                                            Style="{StaticResource WindowButton}" Width="36" VerticalAlignment="Top"
                                            ToolTip="{DynamicResource TabListLabel}" AutomationProperties.Name="{DynamicResource TabListLabel}"
                                            IsEnabled="{Binding HasItems, RelativeSource={RelativeSource TemplatedParent}}"
                                            Click="OpenTabListMenu">
                                        <TextBlock Style="{StaticResource WindowGlyph}" Text="&#xE70D;" />
                                    </Button>
                                    <Button x:Name="newTabButton" DockPanel.Dock="Right"
                                            Style="{StaticResource WindowButton}" Width="36" VerticalAlignment="Top"
                                            ToolTip="{DynamicResource NewTabLabel}" AutomationProperties.Name="{DynamicResource NewTabLabel}"
                                            Click="OpenNewTabMenu">
                                        <TextBlock Style="{StaticResource WindowGlyph}" Text="&#xE710;" />
                                    </Button>
                                    <ScrollViewer x:Name="tabStripScroller" DockPanel.Dock="Left" VerticalScrollBarVisibility="Disabled"
                                                  HorizontalScrollBarVisibility="Hidden" Focusable="False" ScrollChanged="OnTabStripScrollChanged"
                                                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                        <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                                    </ScrollViewer>
                                </DockPanel>
                            </DockPanel>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                          ContentSource="SelectedContent"
                                          KeyboardNavigation.DirectionalNavigation="Contained" />
                    </Grid>
                </ControlTemplate>
    </Window.Resources>
    <Grid x:Name="windowRoot">
        <Border x:Name="groupHost">
            <TabControl x:Name="tabs" AllowDrop="True" Template="{StaticResource TabGroupTemplate}"
                        Padding="0,0,176,0" />
        </Border>
        <Canvas ClipToBounds="True">
            <Border x:Name="broadcastBand" Canvas.Left="2" Canvas.Bottom="2"
                    MaxWidth="500" Visibility="Collapsed" Background="{DynamicResource WindowBackground}">
                <TextBlock x:Name="broadcastStatus" Foreground="{DynamicResource WindowForeground}"
                           TextTrimming="CharacterEllipsis" Padding="6,2" Focusable="True"
                           ToolTipService.ShowsToolTipOnKeyboardFocus="True" />
            </Border>
        </Canvas>
        <DockPanel x:Name="welcomePanel" Margin="18,58,18,18" VerticalAlignment="Top">
            <Image x:Name="welcomeIcon" DockPanel.Dock="Left" Width="96" Height="96"
                   Margin="0,0,20,0" VerticalAlignment="Top"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="welcomeTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="profileHint" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="vaultHint" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0">
            <Button x:Name="menuButton" Style="{StaticResource WindowButton}">
                <TextBlock Style="{StaticResource WindowGlyph}" Text="&#xE700;" />
            </Button>
            <Button x:Name="minimizeButton" Style="{StaticResource WindowButton}">
                <TextBlock Style="{StaticResource WindowGlyph}" Text="&#xE921;" />
            </Button>
            <Button x:Name="maximizeButton" Style="{StaticResource WindowButton}">
                <TextBlock x:Name="maximizeGlyph" Style="{StaticResource WindowGlyph}" Text="&#xE922;" />
            </Button>
            <Button x:Name="closeButton" Style="{StaticResource WindowButton}">
                <TextBlock Style="{StaticResource WindowGlyph}" Text="&#xE8BB;" />
            </Button>
        </StackPanel>
        <Menu x:Name="mainMenu" IsMainMenu="False" Visibility="Collapsed"
              Foreground="{DynamicResource WindowForeground}"
              FocusManager.IsFocusScope="True"
              AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=menuButton}"
              KeyboardNavigation.DirectionalNavigation="Cycle">
            <Menu.Template>
                <ControlTemplate TargetType="Menu">
                    <AdornerDecorator>
                        <Grid x:Name="menuOverlay">
                            <Border x:Name="mainMenuPanel" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="8,43,0,8" MinWidth="164" Style="{StaticResource ApplicationMenuSurface}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="False" Focusable="False">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </AdornerDecorator>
                </ControlTemplate>
            </Menu.Template>
            <Menu.ItemsPanel>
                <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <Menu.Resources>
                <Style x:Key="ApplicationMenuItem" TargetType="MenuItem">
                    <EventSetter Event="MouseEnter" Handler="OnApplicationMenuItemEntered" />
                    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Foreground" Value="{DynamicResource ContextMenuForeground}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Grid>
                                    <Border x:Name="header" Background="Transparent" Padding="8,6"
                                            Margin="4,1" CornerRadius="4" MinHeight="28"
                                            TextElement.Foreground="{TemplateBinding Foreground}">
                                        <DockPanel>
                                            <TextBlock x:Name="submenuArrow" DockPanel.Dock="Left" Margin="0,0,12,0"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Text="&#xE76B;" VerticalAlignment="Center" Visibility="Collapsed" />
                                            <ContentPresenter x:Name="icon" ContentSource="Icon" Margin="0,0,6,0"
                                                              DockPanel.Dock="Left" VerticalAlignment="Center" />
                                            <TextBlock x:Name="checkmark" Margin="0,0,6,0" Text="✓" Visibility="Collapsed"
                                                       DockPanel.Dock="Left" VerticalAlignment="Center" />
                                            <TextBlock x:Name="gesture" DockPanel.Dock="Left" Margin="0,0,16,0"
                                                       Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center" />
                                            <ContentPresenter x:Name="label" ContentSource="Header" RecognizesAccessKey="True"
                                                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <local:ApplicationSubmenu x:Name="submenu" IsOpen="{TemplateBinding IsSubmenuOpen}">
                                        <Border Style="{StaticResource ApplicationMenuSurface}" MinWidth="164"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                          CanContentScroll="False" Focusable="False">
                                                <ItemsPresenter x:Name="ItemsPresenter" />
                                            </ScrollViewer>
                                        </Border>
                                    </local:ApplicationSubmenu>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Icon" Value="{x:Null}">
                                        <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="checkmark" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger Property="InputGestureText" Value="">
                                        <Setter TargetName="gesture" Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <Trigger Property="HasItems" Value="True">
                                        <Setter TargetName="submenuArrow" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="gesture" Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <Trigger Property="IsSubmenuOpen" Value="True">
                                        <Setter TargetName="header" Property="Background"
                                                Value="{DynamicResource MenuBarItemBackgroundSelected}" />
                                    </Trigger>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="header" Property="Background"
                                                Value="{DynamicResource MenuBarItemBackgroundSelected}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="header" Property="Background"
                                                Value="{DynamicResource MenuBarItemBackgroundSelected}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="header" Property="TextElement.Foreground"
                                                Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Menu.Resources>
        </Menu>
    </Grid>
</Window>
